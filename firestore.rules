rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validText(value) { return value is string && value.size() > 0 && value.size() <= 4000; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function canComment() { return signedIn() && (isAdmin() || get(/databases/$(database)/documents/config/rolePermissions).data[get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role].comment == true); }
    function canCreateNews() { return signedIn() && (isAdmin() || get(/databases/$(database)/documents/config/rolePermissions).data[get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role].createNews == true); }
    function canApproveNews() { return signedIn() && (isAdmin() || get(/databases/$(database)/documents/config/rolePermissions).data[get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role].approveNews == true); }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && validText(request.resource.data.message);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.time <= resource.data.createdAt + duration.value(5, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt'])
        && validText(request.resource.data.message)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /news/{newsId} {
      allow read: if signedIn() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow create: if canCreateNews() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && ((resource.data.userId == request.auth.uid && resource.data.approvedAt == null) || (canApproveNews() && request.resource.data.approvedBy == request.auth.uid));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid && resource.data.approvedAt == null;
      match /reactions/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && userId == request.auth.uid && request.resource.data.type in ['like', 'dislike'];
        allow delete: if signedIn() && userId == request.auth.uid;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if canComment() && exists(/databases/$(database)/documents/news/$(newsId))
          && request.resource.data.newsId == newsId
          && request.resource.data.userId == request.auth.uid
          && validText(request.resource.data.text)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == null;
        allow update: if signedIn() && resource.data.userId == request.auth.uid
          && request.time <= resource.data.createdAt + duration.value(5, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
          && validText(request.resource.data.text)
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        match /reactions/{userId} {
          allow read: if signedIn();
          allow create: if signedIn() && userId == request.auth.uid
            && request.resource.data.type in ['like', 'dislike']
            && request.resource.data.createdAt == request.time;
          allow update: if signedIn() && userId == request.auth.uid
            && request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn() && userId == request.auth.uid;
        }
      }
    }
  }
}
